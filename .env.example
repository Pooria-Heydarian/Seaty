# Copy this file to .env and fill in your values.

# Get a key: https://console.cloud.google.com -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=

# Your channel ID (starts with UC...). Find it at https://www.youtube.com/account_advanced
YOUTUBE_CHANNEL_ID=

# Anti-spam: comments shorter than this (after trimming) are ignored
MIN_COMMENT_LENGTH=3

# Only count videos published on/after this date (YYYY-MM-DD). Leave empty to count all.
CITY_START_DATE=
