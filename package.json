{
  "name": "seaty",
  "version": "0.1.0",
  "private": true,
  "description": "A 3D city built from YouTube commenters. One comment = one house, every new video commented on = one more floor.",
  "homepage": "https://pooria-heydarian.github.io/Seaty/",
  "type": "module",
  "scripts": {
    "demo": "node scripts/demo-data.mjs",
    "fetch": "node scripts/fetch-comments.mjs",
    "report": "node scripts/daily-report.mjs",
    "lottery": "node scripts/lottery.mjs",
    "serve": "node scripts/serve.mjs",
    "daily": "node scripts/fetch-comments.mjs && node scripts/requests.mjs",
    "video": "node scripts/render-video.mjs",
    "upload": "node scripts/upload-youtube.mjs",
    "youtube-auth": "node scripts/youtube-auth.mjs",
    "inbox": "node scripts/comment-inbox.mjs",
    "requests": "node scripts/requests.mjs",
    "special": "node scripts/add-special.mjs",
    "finish": "node scripts/daily-report.mjs && node scripts/render-video.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "kokoro-js": "^1.2.1",
    "puppeteer": "^23.11.1"
  }
}
